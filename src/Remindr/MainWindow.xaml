<ui:FluentWindow x:Class="Remindr.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:Remindr.Views.Pages"
                 xmlns:ctl="clr-namespace:Remindr.Views.Controls"
                 xmlns:conv="clr-namespace:Remindr.Converters"
                 xmlns:welcome="clr-namespace:Remindr.Views.Welcome"
                 xmlns:l="clr-namespace:Remindr.Views"
                 Title="Remindr" Icon="pack://application:,,,/Assets/remindr.ico" Width="1280" Height="720" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <!-- ThemeService falls back to Mica (Windows 10 / transparency off) and swaps the Glass brushes. -->
    <ui:FluentWindow.Resources>
        <conv:AddConverter x:Key="AddConverter" />        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Rail geometry (WPF-UI 3.0.5 Left template): the pane grid has a 4px margin each side, so it spans
             4..OpenPaneLength+4 and the content frame starts at OpenPaneLength+8. OpenPaneLength is 232 / 48, so the
             visible rail (glass) is 240 / 56. Items/toggle add another 4px each side, so pills span 8..OpenPaneLength
             (equal 8px inset inside the glass) and the 40px icon column is centred on x=28: the middle of the 56px
             collapsed rail, in both states and throughout the animation. -->

        <!-- Hamburger: same column, size, radius and hover/pressed fills as the nav items. -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible full-size button inside each nav item: the UIA-visible, focusable, invokable part. -->
        <Style x:Key="NavItemInvoke" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav items: fixed 40px icon column (icons never move while the pane width animates; only labels fade),
             pill inset 4px inside the pane grid, radius 6, rounded 3x16 accent bar centred vertically. -->
        <Style x:Key="RemindrNavItemStyle" TargetType="{x:Type ui:NavigationViewItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NavigationViewItemForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"
                                           Fill="{DynamicResource NavigationViewSelectionIndicatorForeground}" />
                                <ContentPresenter x:Name="IconPresenter" Width="20" Height="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Icon}" TextElement.FontSize="16" />
                                <ContentPresenter x:Name="LabelPresenter" Grid.Column="1" Margin="0,0,8,0"
                                                  VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  TextElement.FontSize="14" />
                                <Button x:Name="PART_InvokeButton" Grid.ColumnSpan="2" Style="{StaticResource NavItemInvoke}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Glass rail below the title bar (so the title never straddles its edge). Width = OpenPaneLength + 8: it ends
             exactly where the content frame begins (that frame's 1px left border is the divider; MainWindow squares its
             top-left corner so the two surfaces join without a notch). OpenPaneLength is what MainWindow animates, so
             glass, pane and content move together. Top stroke continues the content frame's top border. -->
        <Border x:Name="NavGlass" Grid.Row="1" HorizontalAlignment="Left" IsHitTestVisible="False"
                Width="{Binding ElementName=RootNavigation, Path=OpenPaneLength, Converter={StaticResource AddConverter}, ConverterParameter=8}"
                Background="{DynamicResource GlassNavSurfaceBrush}"
                BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}" BorderThickness="0,1,0,0" />

        <ui:TitleBar Grid.Row="0" Title="Remindr" Panel.ZIndex="5" />

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1" Background="Transparent"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False" IsPaneOpen="True"
                           OpenPaneLength="232"
                           Transition="FadeInWithSlide">
            <!-- WPF-UI snaps the pane between widths with no animation, so the built-in toggle is off: this button animates
                 OpenPaneLength itself (pane stays "open" to WPF-UI) and fades the labels.
                 The wrapper is as wide as the pane so the button sits in the icon column whatever alignment the template's
                 header presenter uses (a fixed-width Stretch button would be centred). -->
            <ui:NavigationView.PaneHeader>
                <Grid HorizontalAlignment="Left"
                      Width="{Binding Path=OpenPaneLength, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}">
                    <Button x:Name="NavToggle" Click="NavToggle_Click" Margin="4,4,0,6"
                            Style="{StaticResource NavRailButton}" ToolTip="{l:Loc Nav_ToggleTooltip}"
                            AutomationProperties.Name="{l:Loc Nav_ToggleName}">
                        <ui:SymbolIcon Symbol="Navigation24" FontSize="16" />
                    </Button>
                </Grid>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ctl:RemindrNavItem Style="{StaticResource RemindrNavItemStyle}" Content="{l:Loc Nav_Today}" TargetPageType="{x:Type pages:TodayPage}">
                    <ctl:RemindrNavItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" FontSize="16" />
                    </ctl:RemindrNavItem.Icon>
                </ctl:RemindrNavItem>
                <ctl:RemindrNavItem Style="{StaticResource RemindrNavItemStyle}" Content="{l:Loc Nav_Calendar}" TargetPageType="{x:Type pages:CalendarPage}">
                    <ctl:RemindrNavItem.Icon>
                        <!-- CalendarLtr24: "Calendar24" maps to a codepoint the bundled 3.0.5 icon font draws as a stray glyph. -->
                        <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="16" />
                    </ctl:RemindrNavItem.Icon>
                </ctl:RemindrNavItem>
                <ctl:RemindrNavItem Style="{StaticResource RemindrNavItemStyle}" Content="{l:Loc Nav_AllReminders}" TargetPageType="{x:Type pages:AllRemindersPage}">
                    <ctl:RemindrNavItem.Icon>
                        <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="16" />
                    </ctl:RemindrNavItem.Icon>
                </ctl:RemindrNavItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ctl:RemindrNavItem x:Name="ProfileNavItem" Style="{StaticResource RemindrNavItemStyle}" Content="{l:Loc Nav_Profile}" ToolTip="{l:Loc Nav_SwitchProfile}"
                                       Click="ProfileNavItem_Click">
                    <ctl:RemindrNavItem.Icon>
                        <!-- Icon must be an IconElement (a UserControl here crashes). MainWindow swaps this for an ImageIcon when the profile has a picture. -->
                        <ui:SymbolIcon x:Name="NavProfileIcon" Symbol="PersonCircle24" Filled="True" FontSize="16" />
                    </ctl:RemindrNavItem.Icon>
                </ctl:RemindrNavItem>
                <ctl:RemindrNavItem Style="{StaticResource RemindrNavItemStyle}" Content="{l:Loc Nav_Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ctl:RemindrNavItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </ctl:RemindrNavItem.Icon>
                </ctl:RemindrNavItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Update card: a compact card floating at the bottom trailing corner of the content (bottom-left in right-to-left), 24px from
             the edges, so it never covers a page title. Opaque-enough fill (theme solid brush) for readable text over the blobs.
             MainWindow shows it only while a profile is open (never over the welcome, setup, picker or PIN prompt) and slides it up. -->
        <Grid x:Name="UpdateCard" Grid.Row="1" Width="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
              Visibility="Collapsed" AutomationProperties.AutomationId="UpdateBanner" AutomationProperties.Name="{Binding TitleText}">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="UpdateCardSlide" />
            </Grid.RenderTransform>
            <Border Style="{StaticResource GlassShadow}" />
            <Border Style="{StaticResource GlassCard}" Padding="16" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel>
                    <!-- Row 1: icon, title, close (= Later) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" FlowDirection="LeftToRight"
                               Source="pack://application:,,,/Assets/remindr.ico" />
                        <TextBlock Grid.Column="1" Text="{Binding TitleText}" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="UpdateBannerTitle" />
                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" Width="28" Height="28" VerticalAlignment="Top" Margin="8,-2,-6,0"
                                   Command="{Binding LaterCommand}" ToolTip="{l:Loc Update_Later}" AutomationProperties.Name="{l:Loc Update_Later}"
                                   AutomationProperties.AutomationId="UpdateClose">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Dismiss12" FontSize="12" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                    <!-- Row 2: versions -->
                    <TextBlock Text="{Binding VersionsText}" Style="{StaticResource Caption}" Margin="34,2,0,0"
                               Visibility="{Binding ShowVersions, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="UpdateVersions" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Caption}" Margin="34,2,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="UpdateBannerDetail" />

                    <!-- Offer: Update (accent) + What's new on one row, Skip as a small link below. -->
                    <StackPanel Visibility="{Binding IsOffer, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Appearance="Primary" Content="{l:Loc Update_Update}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       MinHeight="32" Command="{Binding UpdateNowCommand}" AutomationProperties.AutomationId="UpdateNow" />
                            <Button Grid.Column="2" Style="{StaticResource GlassPill}" Content="{l:Loc Update_WhatsNew}" HorizontalAlignment="Stretch"
                                    Command="{Binding WhatsNewCommand}" AutomationProperties.AutomationId="UpdateWhatsNew" />
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <Hyperlink Command="{Binding SkipCommand}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="UpdateSkip"><Run Text="{l:Loc Update_Skip}" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Downloading / checking: thin progress bar + Cancel. -->
                    <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.AutomationId="UpdateProgress"
                                     AutomationProperties.Name="{Binding TitleText}" />
                        <Button Style="{StaticResource GlassPill}" Content="{l:Loc Update_Cancel}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding CancelCommand}" AutomationProperties.AutomationId="UpdateCancel" />
                    </StackPanel>

                    <!-- Verified: one full-width button. -->
                    <ui:Button Appearance="Primary" Content="{l:Loc Update_RestartUpdate}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                               MinHeight="32" Margin="0,12,0,0" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                               Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="UpdateInstall" />

                    <!-- Error: Retry + Later. -->
                    <Grid Margin="0,12,0,0" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Appearance="Primary" Content="{l:Loc Update_TryAgain}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   MinHeight="32" Command="{Binding UpdateNowCommand}" AutomationProperties.AutomationId="UpdateTryAgain" />
                        <Button Grid.Column="2" Style="{StaticResource GlassPill}" Content="{l:Loc Update_Later}" HorizontalAlignment="Stretch"
                                Command="{Binding LaterCommand}" AutomationProperties.AutomationId="UpdateErrorLater" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Full-window profile picker; covers the navigation and the window backdrop; the title bar stays on top (ZIndex). -->
        <ctl:ProfilePickerView x:Name="Picker" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- Welcome greeting (first run, Settings > Replay welcome, welcome switch): full window, above the shell and the picker. -->
        <welcome:WelcomeView x:Name="Welcome" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- First-run setup card: rises in over the greeting, replaces the old silent "Me" profile. -->
        <welcome:SetupView x:Name="Setup" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- Host for WPF-UI ContentDialogs (create/edit/delete profile). -->
        <ContentPresenter x:Name="DialogHost" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>


