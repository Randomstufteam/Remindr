<UserControl x:Class="Remindr.Views.Welcome.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             xmlns:conv="clr-namespace:Remindr.Converters"
             xmlns:l="clr-namespace:Remindr.Views"
             Focusable="False"
             AutomationProperties.AutomationId="SetupView"
             AutomationProperties.Name="{l:Loc Setup_Name}">
    <!-- First-run setup: a centred glass card over the drifting blobs. Five pages (Language, Appearance, Profile, PIN, Done) that slide and
         fade, progress dots on top, Back/Next below. DataContext = SetupViewModel (set by Attach). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />

        <Style x:Key="SetupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SetupDesc" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Main action: accent fill. -->
        <Style x:Key="SetupPrimary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="22,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress dots: a small dot, the current one stretches into a pill. Not focusable or clickable (the list only tells screen readers
             "Step 2 of 5"). -->
        <Style x:Key="DotItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Dot" Width="8" Height="8" Margin="4,0" CornerRadius="4"
                                Background="{DynamicResource TextFillColorTertiaryBrush}" Opacity="0.55" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Dot" Property="Opacity" Value="0.7" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="24"
                                                             Duration="{StaticResource DurNormal}" DecelerationRatio="0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Width" To="8"
                                                             Duration="{StaticResource DurNormal}" DecelerationRatio="0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language row. -->
        <Style x:Key="LanguageItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NativeName}" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EnglishLabel}" FontSize="12" Opacity="0.7" Margin="10,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:SymbolIcon x:Name="Check" Grid.Column="1" Symbol="Checkmark24" FontSize="16" Visibility="Collapsed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme card: a mini window drawing, its name and a check badge when chosen. -->
        <Style x:Key="ThemeCard" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="{DynamicResource GlassPillBrush}" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="16" Padding="8,8,8,10" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                            <StackPanel>
                                <Grid>
                                    <ctl:ThemePreview Theme="{Binding Theme}" HorizontalAlignment="Center" />
                                    <Border x:Name="Badge" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-4,-6" Opacity="0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource DurFast}" />
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.96" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Pop" Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.96" />
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                                                    <EasingDoubleKeyFrame.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></EasingDoubleKeyFrame.EasingFunction>
                                                </EasingDoubleKeyFrame>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Badge" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource DurFast}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour swatch (same look as the profile dialog's). -->
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="32" Height="32" Cursor="Hand" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse Margin="4" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource GlassPickerBackdropBrush}">
        <ctl:BlobBackdrop x:Name="Blobs" />

        <Grid x:Name="CardHost" Width="560" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="CardMove" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Border Style="{StaticResource GlassShadow}" />
            <!-- Mostly opaque backing so the blobs and the desktop never fight the text. -->
            <Border CornerRadius="{DynamicResource RadiusPanel}" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.82" />
            <Border Style="{StaticResource GlassCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Progress dots -->
                    <ListBox x:Name="DotsList" Grid.Row="0" ItemsSource="{Binding Dots}" ItemContainerStyle="{StaticResource DotItem}"
                             HorizontalAlignment="Center" Margin="0,20,0,0" Background="Transparent" BorderThickness="0" Padding="0"
                             Focusable="False" IsTabStop="False" IsHitTestVisible="False" SelectionMode="Single"
                             AutomationProperties.AutomationId="SetupDots" AutomationProperties.Name="{l:Loc Setup_Progress}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Pages: all five live in the same cell; the code slides one out and the next in. -->
                    <Grid x:Name="Pages" Grid.Row="1" ClipToBounds="True" Margin="0,8,0,0">
                        <!-- 1. Language -->
                        <Grid x:Name="PageLanguage" Margin="28,12,28,8" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Setup_Language_Title}" Style="{StaticResource SetupTitle}" />
                                <TextBlock Text="{l:Loc Setup_Language_Desc}" Style="{StaticResource SetupDesc}" />
                            </StackPanel>
                            <ui:TextBox x:Name="LanguageSearch" Grid.Row="1" Margin="0,14,0,10" PlaceholderText="{l:Loc Setup_Language_Search}"
                                        AutomationProperties.AutomationId="SetupLanguageSearch" AutomationProperties.Name="{l:Loc Setup_Language_Search}"
                                        Text="{Binding LanguageSearch, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="LanguageSearch_PreviewKeyDown" />
                            <Grid Grid.Row="2">
                                <ListBox x:Name="LanguageList" ItemsSource="{Binding FilteredLanguages}" ItemContainerStyle="{StaticResource LanguageItem}"
                                         Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LanguageList_SelectionChanged"
                                         AutomationProperties.AutomationId="SetupLanguageList" AutomationProperties.Name="{l:Loc Setup_Language_Title}" />
                                <TextBlock x:Name="NoLanguages" Text="{l:Loc Setup_Language_NoMatch}" Style="{StaticResource Caption}" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
                            </Grid>
                        </Grid>

                        <!-- 2. Appearance -->
                        <Grid x:Name="PageAppearance" Margin="28,12,28,8" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Loc Setup_Appearance_Title}" Style="{StaticResource SetupTitle}" />
                                <TextBlock Text="{l:Loc Setup_Appearance_Desc}" Style="{StaticResource SetupDesc}" />
                            </StackPanel>
                            <ListBox x:Name="ThemeList" Grid.Row="1" ItemContainerStyle="{StaticResource ThemeCard}" Background="Transparent"
                                     BorderThickness="0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="ThemeList_SelectionChanged"
                                     AutomationProperties.AutomationId="SetupThemeList" AutomationProperties.Name="{l:Loc Settings_Theme_Name}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>

                        <!-- 3. Your profile -->
                        <ScrollViewer x:Name="PageProfile" Margin="0,0,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="28,12,22,8">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Setup_Profile_Title}" Style="{StaticResource SetupTitle}" />
                                <TextBlock Text="{l:Loc Setup_Profile_Desc}" Style="{StaticResource SetupDesc}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:ProfileAvatar x:Name="PreviewAvatar" Diameter="88" RingThickness="3" VerticalAlignment="Top" Margin="0,2,20,0"
                                                       Color="{Binding Color}" Initial="{Binding Initial}" Avatar="{Binding Avatar}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:Loc Profile_Name}" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox x:Name="NameBox" MaxLength="30" PlaceholderText="{l:Loc Profile_NamePlaceholder}"
                                                    AutomationProperties.AutomationId="SetupName" AutomationProperties.Name="{l:Loc Profile_Name}"
                                                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{l:Loc Profile_Color}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                        <ListBox x:Name="ColorList" SelectedItem="{Binding Color, Mode=TwoWay}" ItemContainerStyle="{StaticResource SwatchItem}"
                                                 BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.AutomationId="SetupColors" AutomationProperties.Name="{l:Loc Profile_Color}">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,6">
                                    <TextBlock Text="{l:Loc Common_Picture}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource GlassPill}" Padding="12,4" MinHeight="28"
                                            Content="{l:Loc Avatar_InitialOnly}" Click="InitialOnly_Click"
                                            ToolTip="{l:Loc Avatar_InitialTooltip}" AutomationProperties.Name="{l:Loc Avatar_InitialOnly}" />
                                </Grid>
                                <ctl:PicturePickerView x:Name="Picker" GridHeight="116" ThumbSize="44" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 4. PIN -->
                        <Grid x:Name="PagePin" Margin="28,12,28,8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Setup_Pin_Title}" Style="{StaticResource SetupTitle}" />
                                <TextBlock Text="{l:Loc Setup_Pin_Desc}" Style="{StaticResource SetupDesc}" />
                                <ctl:PinSetPanel x:Name="PinPanel" Margin="0,18,0,0" Width="320" HorizontalAlignment="Left" />
                                <TextBlock Text="{l:Loc Pin_Note}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- 5. Done -->
                        <Grid x:Name="PageDone" Margin="28,12,28,8" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <Grid HorizontalAlignment="Center" x:Name="DoneAvatarHost">
                                    <ctl:ProfileAvatar x:Name="DoneAvatar" Diameter="88" RingThickness="3"
                                                       Color="{Binding Color}" Initial="{Binding Initial}" Avatar="{Binding Avatar}" />
                                    <Border x:Name="DoneCheck" Width="30" Height="30" CornerRadius="15" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="0,0,-6,-4" Background="{DynamicResource SystemFillColorSuccessBrush}" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="DoneCheckScale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DoneTitle" Style="{StaticResource SetupTitle}" TextAlignment="Center" Margin="0,16,0,0" />
                                <StackPanel x:Name="SummaryRows" Margin="0,18,0,0" MaxWidth="400">
                                    <Border x:Name="RowProfile" Style="{StaticResource GlassChip}" Padding="14,9" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{l:Loc Settings_Profile}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SumProfile" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="RowLanguage" Style="{StaticResource GlassChip}" Padding="14,9" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{l:Loc Settings_Language_Title}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SumLanguage" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="RowTheme" Style="{StaticResource GlassChip}" Padding="14,9" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{l:Loc Settings_Appearance}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SumTheme" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border x:Name="RowPin" Style="{StaticResource GlassChip}" Padding="14,9">
                                        <Grid>
                                            <TextBlock Text="{l:Loc Settings_PinLock}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SumPin" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{l:Loc Setup_Done_Desc}" Style="{StaticResource SetupDesc}" TextAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="24,8,24,22">
                        <!-- Pages 1-4 -->
                        <Grid x:Name="FooterSteps">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackButton" Grid.Column="0" Content="{l:Loc Common_Back}" Style="{StaticResource GlassPill}" MinWidth="88"
                                    Click="Back_Click" AutomationProperties.AutomationId="SetupBack" AutomationProperties.Name="{l:Loc Common_Back}"
                                    Visibility="{Binding CanBack, Converter={StaticResource BoolToVis}}" />
                            <Button x:Name="SkipButton" Grid.Column="2" Content="{l:Loc Setup_Skip}" Style="{StaticResource GlassPill}" MinWidth="88" Margin="0,0,10,0"
                                    Click="Skip_Click" AutomationProperties.AutomationId="SetupSkip" AutomationProperties.Name="{l:Loc Setup_Skip}"
                                    Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}" />
                            <Button x:Name="NextButton" Grid.Column="3" Content="{l:Loc Setup_Next}" Style="{StaticResource SetupPrimary}"
                                    IsEnabled="{Binding CanNext}" Click="Next_Click"
                                    AutomationProperties.AutomationId="SetupNext" AutomationProperties.Name="{l:Loc Setup_Next}" />
                        </Grid>
                        <!-- Page 5 -->
                        <StackPanel x:Name="FooterDone" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="AddFirstButton" Content="{l:Loc Setup_Done_AddFirst}" Style="{StaticResource GlassPill}" Margin="0,0,10,0"
                                    Click="AddFirst_Click" AutomationProperties.AutomationId="SetupAddFirst" AutomationProperties.Name="{l:Loc Setup_Done_AddFirst}" />
                            <Button x:Name="StartButton" Content="{l:Loc Setup_Done_Start}" Style="{StaticResource SetupPrimary}"
                                    Click="Start_Click" AutomationProperties.AutomationId="SetupStart" AutomationProperties.Name="{l:Loc Setup_Done_Start}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
