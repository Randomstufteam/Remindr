<UserControl x:Class="Remindr.Views.Welcome.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             xmlns:l="clr-namespace:Remindr.Views"
             Focusable="True" FocusVisualStyle="{x:Null}"
             AutomationProperties.AutomationId="WelcomeView"
             AutomationProperties.Name="{l:Loc Welcome_Name}">
    <UserControl.Resources>
        <!-- 72px SemiLight Segoe UI Variable Display (the code adds the language's fallback fonts). Ideal text formatting: this is display
             type, not UI text. No script or handwriting face, and the word is never stroked or drawn on. -->
        <Style x:Key="GreetingWord" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="72" />
            <!-- Light here; the code asks for OpenType weight 350 (SemiLight), which XAML has no name for. -->
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="0,18" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Resources>

    <!-- Full-window welcome: the window's Acrylic shows through (transparent backdrop), blurred colour blobs drift behind, and one big
         greeting word at a time settles in. Remind UI's own look: Segoe UI Variable Display type, a blur/scale cross-fade, a hue per word. -->
    <Grid x:Name="Root" Background="{DynamicResource GlassPickerBackdropBrush}">
        <!-- Only when shown over the running app (Replay welcome): hides what is underneath. First run has nothing underneath. -->
        <Border x:Name="Backing" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.94" Visibility="Collapsed" />

        <ctl:BlobBackdrop x:Name="Blobs" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,40">
                <!-- Two word slots on top of each other: the new word settles in while the old one blurs out. -->
                <Grid x:Name="WordHost" Height="190" MinWidth="420" HorizontalAlignment="Center"
                      AutomationProperties.LiveSetting="Off">
                    <TextBlock x:Name="WordA" Style="{StaticResource GreetingWord}" AutomationProperties.LiveSetting="Off" />
                    <TextBlock x:Name="WordB" Style="{StaticResource GreetingWord}" AutomationProperties.LiveSetting="Off" />
                </Grid>

                <Button x:Name="StartButton" Content="{l:Loc Welcome_GetStarted}" Style="{StaticResource GlassPill}"
                        IsDefault="True" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Padding="32,10" MinHeight="44" MinWidth="168" FontSize="16" FontWeight="SemiBold"
                        AutomationProperties.AutomationId="WelcomeStart"
                        AutomationProperties.Name="{l:Loc Welcome_GetStarted}" Click="StartButton_Click" />

                <TextBlock Text="{l:Loc Welcome_Hint}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
