<UserControl x:Class="Remindr.Views.Dialogs.ProfileEditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Remindr.Converters"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             xmlns:l="clr-namespace:Remindr.Views"
             Width="460">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:AddConverter x:Key="AddConverter" />
        <Style x:Key="SwatchItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Width="34" Height="34" Cursor="Hand" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                                     StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse Margin="4" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AddConverter}, ConverterParameter=-160}"
                  CanContentScroll="False" Padding="0,0,8,0">
    <StackPanel ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="0">
        <!-- Live preview on the left, name and colour on the right. -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ctl:ProfileAvatar Grid.Column="0" Diameter="96" VerticalAlignment="Top" Margin="0,18,20,0"
                               Color="{Binding Color}" Initial="{Binding Initial}"
                               Avatar="{Binding Chooser.Avatar}" PreviewImage="{Binding Chooser.PreviewImage}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{l:Loc Profile_Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <ui:TextBox x:Name="NameBox" MaxLength="30" PlaceholderText="{l:Loc Profile_NamePlaceholder}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{l:Loc Profile_Color}" Style="{StaticResource FieldLabel}" />
                <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding Color, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource SwatchItem}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="{l:Loc Common_Picture}" Style="{StaticResource FieldLabel}" />
        <ctl:AvatarChooserView DataContext="{Binding Chooser}" />

        <TextBlock Text="{l:Loc Profile_AvatarLetter}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
        <ui:TextBox MaxLength="1" Width="64" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                    Text="{Binding Initial, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{l:Loc Profile_PinOptional}" Style="{StaticResource FieldLabel}" />
        <StackPanel x:Name="PinChoices">
            <!-- New profile or profile without a PIN -->
            <CheckBox x:Name="SetPinCheck" Content="{l:Loc Pin_Set}" Click="SetPinCheck_Click" />
            <!-- Profile that already has a PIN -->
            <StackPanel x:Name="ExistingPinChoices" Visibility="Collapsed">
                <RadioButton x:Name="KeepRadio" Content="{l:Loc Profile_KeepPin}" IsChecked="True" GroupName="PinAction" Click="PinRadio_Click" />
                <RadioButton x:Name="ChangeRadio" Content="{l:Loc Pin_Change}" GroupName="PinAction" Click="PinRadio_Click" />
                <RadioButton x:Name="RemoveRadio" Content="{l:Loc Pin_Remove}" GroupName="PinAction" Click="PinRadio_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSettingPin, Converter={StaticResource BoolToVis}}">
            <!-- Standard PasswordBox: Password is not bindable, so PasswordChanged (code-behind) feeds NewPin/ConfirmPin. -->
            <TextBlock Text="{l:Loc Pin_New}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <PasswordBox FlowDirection="LeftToRight" x:Name="NewPinBox" MaxLength="4" AutomationProperties.Name="{l:Loc Pin_New}"
                         PasswordChanged="NewPinBox_PasswordChanged" />
            <TextBlock Text="{l:Loc Pin_Repeat}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
            <PasswordBox FlowDirection="LeftToRight" x:Name="ConfirmPinBox" MaxLength="4" AutomationProperties.Name="{l:Loc Pin_Repeat}"
                         PasswordChanged="ConfirmPinBox_PasswordChanged" />
        </StackPanel>

        <TextBlock Text="{l:Loc Pin_Note}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <TextBlock Text="{Binding ShownError}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="16"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
    </StackPanel>
    </ScrollViewer>
</UserControl>

