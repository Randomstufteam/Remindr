<UserControl x:Class="Remindr.Views.Dialogs.ReminderEditDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:Remindr.Converters"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             xmlns:l="clr-namespace:Remindr.Views"
             Width="460" PreviewKeyDown="Root_PreviewKeyDown" PreviewKeyUp="Root_PreviewKeyUp">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:AddConverter x:Key="AddConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PictureConverter x:Key="PictureConv" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- Same height cap as the profile dialog: window height - 160, then scroll. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource AddConverter}, ConverterParameter=-160}"
                  CanContentScroll="False" Padding="0,0,8,0">
        <StackPanel ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="0">
            <TextBlock Text="{l:Loc Common_Title}" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
            <!-- Picture button (shows the chosen picture) + title. The picker is a popup, so the dialog doesn't grow. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PictureButton" Width="40" Height="40" Margin="0,0,8,0" VerticalAlignment="Top"
                        Click="PictureButton_Click" Style="{StaticResource GlassPill}" Padding="0"
                        ToolTip="{Binding IconButtonName}" AutomationProperties.Name="{Binding IconButtonName}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Image24" FontSize="18"
                                       Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                        <Image Width="28" Height="28" FlowDirection="LeftToRight" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding Icon, Converter={StaticResource PictureConv}, ConverterParameter=64}" />
                    </Grid>
                </Button>
                <ui:TextBox x:Name="TitleBox" Grid.Column="1" MaxLength="120" PlaceholderText="{l:Loc Reminder_TitlePlaceholder}"
                            AutomationProperties.Name="{l:Loc Common_Title}"
                            Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                <Popup x:Name="PicturePopup" PlacementTarget="{Binding ElementName=PictureButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="6"
                       Opened="PicturePopup_Opened" Closed="PicturePopup_Closed">
                    <Border Style="{StaticResource GlassCard}" Width="420" Margin="0,0,16,16"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" KeyboardNavigation.TabNavigation="Cycle"
                            KeyboardNavigation.ControlTabNavigation="Cycle">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{l:Loc Common_Picture}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Button Content="{l:Loc Reminder_NoPicture}" HorizontalAlignment="Right" Click="NoPicture_Click"
                                        Style="{StaticResource GlassPill}" AutomationProperties.Name="{l:Loc Reminder_NoPicture}" />
                            </Grid>
                            <ctl:PicturePickerView x:Name="Picker" DataContext="{Binding Picker}" GridHeight="190" ThumbSize="40" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Date + automatic day of the week. -->
            <TextBlock Text="{l:Loc Common_Date}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="DateBox" SelectedDate="{Binding DueDate, Mode=TwoWay}"
                            AutomationProperties.Name="{l:Loc Common_Date}" />
                <TextBlock x:Name="DayOfWeekLabel" Grid.Column="1" Text="{Binding DayOfWeekText}" MinWidth="84"
                           Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Grid>

            <!-- Time: editable box with 15-minute suggestions; All day disables it. -->
            <TextBlock Text="{l:Loc Common_Time}" Style="{StaticResource FieldLabel}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TimeBox" IsEditable="True" IsEnabled="{Binding TimeEnabled}"
                          ItemsSource="{Binding TimeSuggestions}" Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{l:Loc Common_Time}" MaxDropDownHeight="240" />
                <ui:ToggleSwitch x:Name="AllDaySwitch" Grid.Column="1" Content="{l:Loc Time_AllDay}" Margin="16,0,0,0"
                                 VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Time_AllDay}"
                                 IsChecked="{Binding IsAllDay, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="{l:Loc Common_Category}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      AutomationProperties.Name="{l:Loc Common_Category}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                     Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Common_Important}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:Loc Reminder_ImportantDesc}" Style="{StaticResource Caption}" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="ImportantSwitch" Grid.Column="1" AutomationProperties.Name="{l:Loc Common_Important}"
                                 IsChecked="{Binding IsImportant, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="{l:Loc Common_Notes}" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="140"
                        VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                        PlaceholderText="{l:Loc Reminder_NotesPlaceholder}" AutomationProperties.Name="{l:Loc Common_Notes}"
                        Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding ShownError}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="16"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

