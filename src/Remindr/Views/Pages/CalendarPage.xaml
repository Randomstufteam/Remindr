<Page x:Class="Remindr.Views.Pages.CalendarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Remindr.Views.Controls"
      xmlns:conv="clr-namespace:Remindr.Converters"
      xmlns:vm="clr-namespace:Remindr.ViewModels"
      xmlns:l="clr-namespace:Remindr.Views"
      Title="{l:Loc Nav_Calendar}" Background="Transparent">
    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The card is the shared ReminderCard control. -->
        <DataTemplate x:Key="ReminderCard" DataType="{x:Type vm:ReminderItemViewModel}">
            <ctl:ReminderCard />
        </DataTemplate>

        <!-- Square glass button for prev / next. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GlassPill}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- One segment of the Month / Week / Agenda control. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="9" Padding="14,4" MinHeight="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <!-- The accent fill is the one sliding SegmentPill behind the segments, not a fill per button. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Visual-less button: just hosts its content, exposing InvokePattern to UI Automation. -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category dot under a day number (neutral when uncategorized). -->
        <Style x:Key="DayDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Fill" Value="{Binding Color, Converter={StaticResource HexToBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Month cell. DataContext = CalendarDayViewModel. Clicks are routed to the view model by the page. -->
        <DataTemplate x:Key="MonthCell" DataType="{x:Type vm:CalendarDayViewModel}">
            <!-- A real Button (no own visuals, not a tab stop: the grid is the one tab stop) so each cell is Invoke-able via UIA.
                 Mouse is handled in PreviewMouseLeftButtonDown (click / double-click); Click is the UIA / keyboard-less path. -->
            <Button Style="{StaticResource CellButton}" PreviewMouseLeftButtonDown="OnDayMouseDown" Click="OnDayInvoke"
                    AutomationProperties.Name="{Binding AutomationName}">
            <Grid>
            <Border x:Name="Cell" Margin="1" CornerRadius="12" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                    Cursor="Hand">
                <Grid x:Name="CellContent" Margin="6,2,6,3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="NumberBadge" Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Left">
                        <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <!-- Spans both rows, bottom-right: on short cells (narrow layout at 640 px tall the rows are ~40 px)
                         the * row collapses to 0 and dots placed in it would be clipped away; here they sit beside the number. -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Top"
                                HorizontalAlignment="Left" Height="26" Margin="31,0,0,0">
                        <ItemsControl ItemsSource="{Binding Dots}" Focusable="False" IsTabStop="False"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Style="{StaticResource DayDot}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="+" FontSize="11" FontWeight="Bold" Margin="0,-3,3,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasMoreDots, Converter={StaticResource BoolToVis}}" />
                        <!-- Accent dot: at least one important reminder that day. -->
                        <Ellipse Width="7" Height="7" Margin="3,0,0,0" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                 Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1"
                                 Visibility="{Binding HasImportant, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- The selection ring: scales 0.9 to 1 when the day becomes selected (Anim.RingWhen). Opacity 0 at rest. -->
            <Border x:Name="Ring" Margin="1" CornerRadius="12" BorderThickness="2" IsHitTestVisible="False" Opacity="0"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    ctl:Anim.RingWhen="{Binding IsSelected}" />
            </Grid>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                    <Setter TargetName="CellContent" Property="Opacity" Value="0.4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="NumberBadge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource GlassPillBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Week column. DataContext = CalendarWeekColumnViewModel. -->
        <DataTemplate x:Key="WeekColumn" DataType="{x:Type vm:CalendarWeekColumnViewModel}">
            <Border x:Name="Column" Style="{StaticResource GlassPanel}" CornerRadius="14" Margin="2,0" Padding="2,8"
                    BorderThickness="1" MouseLeftButtonDown="OnWeekColumnMouseDown"
                    AutomationProperties.Name="{Binding AutomationName}">
                <DockPanel>
                    <!-- Header is a visual-less Button so the day can be selected through UI Automation (Invoke). -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource CellButton}" Margin="2,0,0,8"
                            HorizontalAlignment="Stretch" PreviewMouseLeftButtonDown="OnWeekHeaderMouseDown" Click="OnWeekHeaderInvoke"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <StackPanel>
                            <TextBlock Text="{Binding Weekday}" Style="{StaticResource Caption}" />
                            <Border x:Name="NumberBadge" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Left" Margin="0,2,0,0">
                                <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- Focusable=False: a focusable ScrollViewer marks MouseLeftButtonDown handled, which would swallow
                         clicks/double-clicks on the empty part of the column before they reach OnWeekColumnMouseDown. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                                  Focusable="False">
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ReminderCard}" Focusable="False" IsTabStop="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="NumberBadge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Column" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Column" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Agenda day: heading + its cards. -->
        <DataTemplate x:Key="AgendaDay" DataType="{x:Type vm:ReminderGroupViewModel}">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" FontSize="15" Margin="2,10,0,10" />
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ReminderCard}" Focusable="False" IsTabStop="False" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{DynamicResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, Month/Week/Agenda, prev / Today / next -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ctl:Anim.FadeInOnLoad="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource GlassChip}" Padding="3" CornerRadius="12" Margin="0,0,12,0">
                    <Grid>
                        <!-- One selection pill slides between three equal-width segments (the page sets its width and X; Anim.SlidePill). -->
                        <Border x:Name="SegmentPill" HorizontalAlignment="Left" Width="0" CornerRadius="9"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                        <UniformGrid x:Name="SegmentGrid" Rows="1" Columns="3">
                            <RadioButton GroupName="CalendarMode" Content="{l:Loc Calendar_Month}" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding IsMonth, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Calendar_MonthViewName}" />
                            <RadioButton GroupName="CalendarMode" Content="{l:Loc Calendar_Week}" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding IsWeek, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Calendar_WeekViewName}" />
                            <RadioButton GroupName="CalendarMode" Content="{l:Loc Calendar_Agenda}" Style="{StaticResource SegmentButton}"
                                         IsChecked="{Binding IsAgenda, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Calendar_AgendaViewName}" />
                        </UniformGrid>
                    </Grid>
                </Border>
                <Button Style="{StaticResource NavButton}" Command="{Binding PreviousCommand}" ToolTip="{l:Loc Calendar_Previous}"
                        AutomationProperties.Name="{l:Loc Calendar_Previous}">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource GlassPill}" Content="{l:Loc Common_Today}" Margin="4,0" Padding="12,4"
                        Command="{Binding GoToTodayCommand}" AutomationProperties.Name="{l:Loc Calendar_GoToToday}" />
                <Button Style="{StaticResource NavButton}" Command="{Binding NextCommand}" ToolTip="{l:Loc Calendar_Next}"
                        AutomationProperties.Name="{l:Loc Calendar_Next}">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Month ================= -->
        <DockPanel Grid.Row="1" LastChildFill="True" Visibility="{Binding IsMonth, Converter={StaticResource BoolToVis}}">
            <!-- Day panel: to the right, or below the grid on a narrow page. -->
            <Grid x:Name="DayPanel">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="DockPanel.Dock" Value="Right" />
                        <Setter Property="Width" Value="340" />
                        <Setter Property="Margin" Value="16,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                <Setter Property="DockPanel.Dock" Value="Bottom" />
                                <Setter Property="Width" Value="NaN" />
                                <Setter Property="Height" Value="210" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Style="{StaticResource GlassShadow}" />
                <Border Padding="16,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                    <Setter Property="Padding" Value="14,8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <!-- Wide: button on its own row above the title. Narrow: button right-aligned on the title row. -->
                        <Grid DockPanel.Dock="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Defaults live in the styles (not as local attributes): a local value would beat the narrow DataTrigger. -->
                            <ui:Button Appearance="Primary" Content="{l:Loc Reminder_New}"
                                       Command="{Binding NewReminderCommand}" ToolTip="{l:Loc Calendar_NewOnDayTooltip}"
                                       AutomationProperties.Name="{l:Loc Reminder_New}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,10,0,10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                                <Setter Property="Grid.Column" Value="1" />
                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                <Setter Property="Grid.RowSpan" Value="2" />
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Margin" Value="8,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.RowSpan" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                                <Setter Property="Grid.Row" Value="0" />
                                                <Setter Property="Grid.RowSpan" Value="2" />
                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedDayTitle}" Style="{StaticResource SectionHeader}" FontSize="16"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedDayCaption}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding SelectedDayItems}" ItemTemplate="{StaticResource ReminderCard}"
                                              Margin="2,0" Focusable="False" IsTabStop="False" />
                                <!-- Empty day: a floating picture over the caption (smaller in the narrow layout, where the panel is short). -->
                                <StackPanel Margin="2,4,0,0" Visibility="{Binding SelectedDayEmpty, Converter={StaticResource BoolToVis}}">
                                    <ctl:FloatingPicture Picture="builtin:calendar" Margin="0,0,0,8">
                                        <ctl:FloatingPicture.Style>
                                            <Style TargetType="ctl:FloatingPicture">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                                                        <Setter Property="Size" Value="48" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ctl:FloatingPicture.Style>
                                    </ctl:FloatingPicture>
                                    <TextBlock Text="{l:Loc Calendar_DayEmpty}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Month grid -->
            <Grid>
                <Border Style="{StaticResource GlassShadow}" />
                <Border Style="{StaticResource GlassCard}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsControl ItemsSource="{Binding Weekdays}" Margin="2,0,2,4" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- One tab stop: arrow keys move the selected day, Enter adds a reminder on it. -->
                        <!-- MonthHost stacks the live grid and, during a month change, a picture of the old one (MonthSnap) that slides out. -->
                        <Grid x:Name="MonthHost" Grid.Row="1" ClipToBounds="True">
                        <ItemsControl x:Name="MonthGrid" ItemsSource="{Binding MonthCells}"
                                      ItemTemplate="{StaticResource MonthCell}" Focusable="True" IsTabStop="True"
                                      FocusVisualStyle="{DynamicResource FocusRing}" AutomationProperties.Name="{l:Loc Calendar_MonthGridName}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.InputBindings>
                                <KeyBinding Key="Left" Command="{Binding MoveSelectionCommand}" CommandParameter="Left" />
                                <KeyBinding Key="Right" Command="{Binding MoveSelectionCommand}" CommandParameter="Right" />
                                <KeyBinding Key="Up" Command="{Binding MoveSelectionCommand}" CommandParameter="Up" />
                                <KeyBinding Key="Down" Command="{Binding MoveSelectionCommand}" CommandParameter="Down" />
                                <KeyBinding Key="Return" Command="{Binding NewReminderCommand}" />
                            </ItemsControl.InputBindings>
                        </ItemsControl>
                        <!-- The month just left: the page fills it with the old cells for the slide-out (see OnNavigating), then empties it. -->
                        <ItemsControl x:Name="MonthGridOut" ItemTemplate="{StaticResource MonthCell}" Visibility="Collapsed"
                                      IsHitTestVisible="False" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="6" Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ================= Week ================= -->
        <!-- The 7 columns share the viewport width (Width is bound to it); below 90 px per column (MinWidth) it scrolls. -->
        <ScrollViewer x:Name="WeekScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="Transparent"
                      Visibility="{Binding IsWeek, Converter={StaticResource BoolToVis}}">
            <Grid x:Name="WeekHost" MinWidth="630" Width="{Binding ViewportWidth, ElementName=WeekScroll}" HorizontalAlignment="Left" ClipToBounds="True">
            <ItemsControl x:Name="WeekColumnsList" ItemsSource="{Binding WeekColumns}" ItemTemplate="{StaticResource WeekColumn}"
                          Focusable="False" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl x:Name="WeekColumnsOut" ItemTemplate="{StaticResource WeekColumn}" Visibility="Collapsed"
                          IsHitTestVisible="False" Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ================= Agenda ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent"
                      Visibility="{Binding IsAgenda, Converter={StaticResource BoolToVis}}">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding AgendaGroups}" ItemTemplate="{StaticResource AgendaDay}" Focusable="False" IsTabStop="False" />
                <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"
                      Visibility="{Binding AgendaEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassCard}" Padding="32">
                        <StackPanel>
                            <!-- Remind UI 0.4: a floating picture, then the title, caption and button stagger in. -->
                            <ctl:FloatingPicture Picture="builtin:tear_off_calendar" Size="96" ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="0" />
                            <TextBlock Text="{l:Loc Calendar_AgendaEmptyTitle}" Style="{StaticResource SectionHeader}" FontSize="16" Margin="0,12,0,4"
                                       ctl:Anim.FadeInOnLoad="True" />
                            <TextBlock Text="{Binding AgendaEmptyText}" Style="{StaticResource Caption}" ctl:Anim.FadeInOnLoad="True" />
                            <ui:Button Appearance="Primary" Content="{l:Loc Reminder_New}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                       ctl:Anim.FadeInOnLoad="True"
                                       Command="{Binding NewReminderCommand}" AutomationProperties.Name="{l:Loc Calendar_NewEmptyAgendaName}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
