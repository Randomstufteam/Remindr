<Page x:Class="Remindr.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Remindr.Views.Controls"
      xmlns:l="clr-namespace:Remindr.Views"
      Title="{l:Loc Nav_Settings}" Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="{DynamicResource PagePadding}">
            <!-- Stretch up to 1000px, then stay left-aligned like Windows 11 Settings. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Nav_Settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />

                <!-- Appearance -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Appearance}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Color24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_Theme_Title}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Theme_Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" MinWidth="160" VerticalAlignment="Center" AutomationProperties.Name="{l:Loc Settings_Theme_Name}"
                                  ItemsSource="{Binding Themes}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </Grid>
                </Border></Grid>

                <!-- Language: native names; changing it re-labels the whole app at once. -->
                <Grid ctl:Anim.FadeInOnLoad="True" Margin="0,8,0,0">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="LocalLanguage24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_Language_Title}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Language_Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                                <Run Text="{l:Loc Settings_Language_Note}" />
                                <Hyperlink Command="{Binding SuggestTranslationCommand}"><Run Text="{l:Loc Settings_Language_ReportLink}" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <!-- Shows the current language in its own name; opens the searchable picker (the same control setup uses). -->
                            <Button x:Name="LanguageButton" Style="{StaticResource GlassPill}" MinWidth="200" Click="LanguageButton_Click"
                                    AutomationProperties.AutomationId="SettingsLanguageButton"
                                    AutomationProperties.Name="{Binding LanguageButtonName}" ToolTip="{l:Loc Settings_Language_Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CurrentLanguage.NativeName}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" VerticalOffset="6"
                                   Opened="LanguagePopup_Opened" Closed="LanguagePopup_Closed">
                                <Border Style="{StaticResource GlassCard}" Width="400" Height="440" Margin="0,0,16,16"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" KeyboardNavigation.TabNavigation="Cycle"
                                        KeyboardNavigation.ControlTabNavigation="Cycle">
                                    <ctl:LanguageList x:Name="LanguagePicker" ClosesOnEscape="True" SearchAutomationId="SettingsLanguageSearch"
                                                      SelectedCode="{Binding CurrentLanguage.Code, Mode=OneWay}"
                                                      LanguageChosen="LanguagePicker_LanguageChosen" CloseRequested="LanguagePicker_CloseRequested" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </Border></Grid>

                <!-- Profile -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Profile}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ctl:ProfileAvatar Grid.Column="0" Diameter="40" RingThickness="2" Margin="0,0,16,0" VerticalAlignment="Center"
                                           Color="{Binding CurrentColor}" Initial="{Binding CurrentInitial}" Avatar="{Binding CurrentAvatar}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SignedInText}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Profile_Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:Loc Settings_ChangePicture}" Style="{StaticResource GlassPill}" Command="{Binding ChangePictureCommand}" />
                            <Button Content="{l:Loc Settings_SwitchProfile}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding SwitchProfileCommand}" />
                            <Button Content="{l:Loc Common_Edit}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding EditCurrentProfileCommand}" />
                        </StackPanel>
                    </Grid>
                </Border></Grid>

                <!-- PIN lock -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_PinLock}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PinStatusText}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Pin_Desc}"
                                       Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:Loc Pin_Set}" Style="{StaticResource GlassPill}" Command="{Binding SetPinCommand}"
                                    Visibility="{Binding HasNoPin, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}">
                                <Button Content="{l:Loc Pin_Change}" Style="{StaticResource GlassPill}" Command="{Binding ChangePinCommand}" />
                                <Button Content="{l:Loc Pin_Remove}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding RemovePinCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border></Grid>

                <!-- Notifications -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Notifications}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Alert24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_TestToast_Title}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_TestToast_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{l:Loc Settings_TestToast_Button}" Style="{StaticResource GlassPill}" Margin="16,0,0,0"
                                Command="{Binding SendTestNotificationCommand}" AutomationProperties.AutomationId="SendTestNotification" />
                    </Grid>
                </Border></Grid>

                <Grid ctl:Anim.FadeInOnLoad="True" Margin="0,12,0,0">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowMinimize24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_CloseToTray_Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Loc Settings_CloseToTray_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="CloseToTrayToggle"
                                         AutomationProperties.Name="{l:Loc Settings_CloseToTray_Title}" />
                    </Grid>
                </Border></Grid>

                <Grid ctl:Anim.FadeInOnLoad="True" Margin="0,12,0,0">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Power24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_StartWithWindows_Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Loc Settings_StartWithWindows_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="StartWithWindowsToggle"
                                         AutomationProperties.Name="{l:Loc Settings_StartWithWindows_Title}" />
                    </Grid>
                </Border></Grid>

                <Grid ctl:Anim.FadeInOnLoad="True" Margin="0,12,0,0">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="WeatherSunny24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_DailySummary_Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Loc Settings_DailySummary_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="110"
                                  ItemsSource="{Binding SummaryTimes}" ItemStringFormat="t" SelectedItem="{Binding SummaryTime, Mode=TwoWay}"
                                  AutomationProperties.AutomationId="DailySummaryTime"
                                  AutomationProperties.Name="{l:Loc Settings_DailySummary_Title}" />
                        <ui:ToggleSwitch Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding DailySummary, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="DailySummaryToggle"
                                         AutomationProperties.Name="{l:Loc Settings_DailySummary_Title}" />
                    </Grid>
                </Border></Grid>

                <!-- AI assistant (preview) -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Assistant}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Sparkle24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_Assistant_Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                            <TextBlock Text="{l:Loc Settings_Assistant_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="{l:Loc Assistant_Caption_English}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding AssistantEnabled, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="AssistantToggle"
                                         AutomationProperties.Name="{l:Loc Settings_Assistant_Title}" />

                        <!-- Graphics card and model: only while the assistant is on. -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
                                    Visibility="{Binding AssistantEnabled, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Loc Settings_Assistant_Gpu}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:Loc Settings_Assistant_Gpu_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,16,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center" ItemsSource="{Binding GpuOptions}" DisplayMemberPath="Name"
                                          SelectedValuePath="Mode" SelectedValue="{Binding Gpu, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="AssistantGpu" AutomationProperties.Name="{l:Loc Settings_Assistant_Gpu}" />
                            </Grid>
                            <TextBlock Text="{l:Loc Settings_Assistant_Gpu_Restart}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding GpuNeedsRestart, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding RunningOn}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Visibility="{Binding HasRunningOn, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="AssistantRunningOn" />
                            <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasGpuNote, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{l:Loc Settings_Assistant_Model}" Style="{StaticResource Body}" Margin="0,16,0,8" />
                            <ctl:ModelPicker DataContext="{Binding Models}" />
                        </StackPanel>
                    </Grid>
                </Border></Grid>

                <!-- Voice (under the assistant card; only while the assistant is on) -->
                <StackPanel DataContext="{Binding Voice}" Visibility="{Binding DataContext.AssistantEnabled, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}">
                    <StackPanel.Resources>
                        <!-- One voice-model download row (ModelRowViewModel): name, download, progress with pause/resume/cancel, error, remove, credit. -->
                        <DataTemplate x:Key="VoiceModelRow">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc Voice_Model_Installed}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Primary" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:Loc Assistant_Dl_Download}" Command="{Binding DownloadCommand}"
                                           Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Title}" />
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,6,0,8"
                                                 AutomationProperties.Name="{Binding ProgressText}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{l:Loc Assistant_Dl_Pause}" Style="{StaticResource GlassPill}" Command="{Binding PauseCommand}"
                                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{l:Loc Assistant_Dl_Resume}" Style="{StaticResource GlassPill}" Command="{Binding ResumeCommand}"
                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="{l:Loc Common_Cancel}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding CancelDownloadCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <Button Content="{l:Loc Assistant_Dl_Remove}" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding RemoveCommand}" Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Credit}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasCredit, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </StackPanel.Resources>
                    <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Voice_Section}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                    <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Mic24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{l:Loc Voice_Title}" Style="{StaticResource Body}" TextWrapping="Wrap" />
                                <TextBlock Text="{l:Loc Voice_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="VoiceToggle" AutomationProperties.Name="{l:Loc Voice_Title}" />

                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
                                        Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}">
                                <!-- Speech model download -->
                                <ContentControl Content="{Binding Hearing}" ContentTemplate="{StaticResource VoiceModelRow}" Focusable="False" />

                                <!-- Spoken replies -->
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{l:Loc Voice_Speak}" Style="{StaticResource Body}" />
                                        <TextBlock Text="{l:Loc Voice_Speak_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,16,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SpeakReplies, Mode=TwoWay}"
                                                     AutomationProperties.AutomationId="VoiceSpeakToggle" AutomationProperties.Name="{l:Loc Voice_Speak}" />
                                </Grid>
                                <Grid Margin="0,12,0,0" Visibility="{Binding SpeakReplies, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:Loc Voice_Choice}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" MinWidth="200" ItemsSource="{Binding Voices}" DisplayMemberPath="Display" SelectedValuePath="Name"
                                              SelectedValue="{Binding SelectedVoice, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="VoiceChoice" AutomationProperties.Name="{l:Loc Voice_Choice}" />
                                </Grid>
                                <!-- Natural voice (Kokoro): two sizes of the same voice; without one, replies use a Windows voice -->
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding SpeakReplies, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{l:Loc Voice_Natural_Title}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{l:Loc Voice_Natural_Desc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <ContentControl Margin="0,12,0,0" Content="{Binding NaturalOriginal}" ContentTemplate="{StaticResource VoiceModelRow}" Focusable="False" />
                                    <ContentControl Margin="0,12,0,0" Content="{Binding NaturalSmall}" ContentTemplate="{StaticResource VoiceModelRow}" Focusable="False" />
                                    <TextBlock Text="{l:Loc Voice_Natural_Credit}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border></Grid>
                </StackPanel>

                <!-- Help & feedback -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Help}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Bug24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_Help_Title}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Help_Desc}"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:Loc Settings_ReportBug}" Style="{StaticResource GlassPill}" Command="{Binding ReportBugCommand}" />
                            <Button Content="{l:Loc Settings_SuggestFeature}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding SuggestFeatureCommand}" />
                            <Button Content="{l:Loc Settings_OpenLogs}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding OpenLogFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </Border></Grid>

                <!-- Updates: the start-up check (only compares version numbers with GitHub's public release info). -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_Updates}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowSync24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Settings_Update_Title}" Style="{StaticResource Body}" />
                            <TextBlock Text="{l:Loc Settings_Update_Privacy}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                         IsChecked="{Binding Updates.CheckEnabled, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="UpdateCheckToggle"
                                         AutomationProperties.Name="{l:Loc Settings_Update_Title}" />
                    </Grid>
                </Border></Grid>

                <!-- About -->
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Settings_About}" Style="{StaticResource SectionHeader}" Margin="0,24,0,8" />
                <Grid ctl:Anim.FadeInOnLoad="True">                <Border Style="{StaticResource GlassShadow}" />                <Border Style="{StaticResource GlassCard}">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Body}" />
                            <TextBlock Text="{Binding RemindUiText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding LicenseText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <Button Content="{l:Loc WhatsNew_Open}" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding ShowWhatsNewCommand}" AutomationProperties.AutomationId="ShowWhatsNew" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:Loc Settings_ViewGitHub}" Style="{StaticResource GlassPill}" Command="{Binding OpenGitHubCommand}" />
                            <Button Content="{l:Loc Settings_Notices}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding OpenNoticesCommand}" />
                            <Button Content="{l:Loc Settings_ReplayWelcome}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding ReplayWelcomeCommand}"
                                    AutomationProperties.AutomationId="ReplayWelcome" />
                        </StackPanel>
                    </Grid>
                    <!-- Manual update check + its status line. -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" />
                        <TextBlock Grid.Column="1" Text="{Binding Updates.StatusText}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="UpdateStatus" />
                        <Button Grid.Column="2" Content="{l:Loc Settings_CheckForUpdates}" Style="{StaticResource GlassPill}" Margin="16,0,0,0"
                                Command="{Binding Updates.CheckNowCommand}" AutomationProperties.AutomationId="CheckForUpdates" />
                    </Grid>
                    </StackPanel>
                </Border></Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>


