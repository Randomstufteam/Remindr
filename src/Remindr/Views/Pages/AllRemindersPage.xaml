<Page x:Class="Remindr.Views.Pages.AllRemindersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Remindr.Views.Controls"
      xmlns:conv="clr-namespace:Remindr.Converters"
      xmlns:vm="clr-namespace:Remindr.ViewModels"
      xmlns:l="clr-namespace:Remindr.Views"
      Title="{l:Loc Nav_AllReminders}" Background="Transparent">
    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The card itself is the shared ReminderCard control (Views/Controls/ReminderCard.xaml). -->
        <DataTemplate x:Key="ReminderCard" DataType="{x:Type vm:ReminderItemViewModel}">
            <ctl:ReminderCard />
        </DataTemplate>

        <!-- Group: header + its cards. -->
        <DataTemplate DataType="{x:Type vm:ReminderGroupViewModel}">
            <StackPanel Margin="0,0,0,12">
                <!-- Normal header -->
                <TextBlock x:Name="Heading" Text="{Binding Title}" Style="{StaticResource SectionHeader}" FontSize="15"
                           Margin="2,10,0,10"
                           Visibility="{Binding IsRegularGroup, Converter={StaticResource BoolToVis}}" />
                <!-- Completed: collapsible header -->
                <Button Margin="0,10,0,10" HorizontalAlignment="Left" Command="{Binding ToggleExpandedCommand}"
                        Visibility="{Binding IsCompletedGroup, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource GlassPill}" Padding="10,4"
                        AutomationProperties.Name="{l:Loc AllReminders_CompletedName}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ChevronRight24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Symbol" Value="ChevronDown24" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CountText, StringFormat=' ({0})'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ReminderCard}"
                              Visibility="{Binding ItemsVisible, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="Heading" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <Grid Margin="{DynamicResource PagePadding}" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="{l:Loc Reminder_New}" VerticalAlignment="Top"
                               Command="{Binding NewReminderCommand}" ToolTip="{l:Loc Reminder_NewTooltip}"
                               AutomationProperties.Name="{l:Loc Reminder_New}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel>
                        <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Nav_AllReminders}" Style="{StaticResource PageTitle}" />
                        <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Empty state -->
                <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,12,0,0" ctl:Anim.FadeInOnLoad="True"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassCard}" Padding="32">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="TaskListSquareLtr24" FontSize="32" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{l:Loc AllReminders_Empty_Title}" Style="{StaticResource SectionHeader}" FontSize="16" Margin="0,12,0,4" />
                            <TextBlock Text="{l:Loc AllReminders_Empty_Text}"
                                       Style="{StaticResource Caption}" />
                            <ui:Button Appearance="Primary" Content="{l:Loc Reminder_New}" Margin="0,16,0,0" HorizontalAlignment="Left"
                                       Command="{Binding NewReminderCommand}" AutomationProperties.Name="{l:Loc AllReminders_NewEmptyName}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding Groups}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

