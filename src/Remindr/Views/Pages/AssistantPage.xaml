<Page x:Class="Remindr.Views.Pages.AssistantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:ctl="clr-namespace:Remindr.Views.Controls"
      xmlns:vm="clr-namespace:Remindr.ViewModels"
      xmlns:l="clr-namespace:Remindr.Views"
      Title="{l:Loc Assistant_Title}" Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- The shared compact reminder card; a click opens the edit dialog (the check box and right-click menu keep working). -->
        <DataTemplate x:Key="FoundCard" DataType="{x:Type vm:ReminderItemViewModel}">
            <Border Background="Transparent" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding EditCommand}" />
                </Border.InputBindings>
                <ctl:ReminderCard />
            </Border>
        </DataTemplate>

        <!-- A choice: the whole card is one button, so it works by mouse and keyboard. -->
        <DataTemplate DataType="{x:Type vm:ChoiceItem}">
            <Button Command="{Binding PickCommand}" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" FocusVisualStyle="{DynamicResource FocusRing}" AutomationProperties.Name="{Binding Card.Title}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <ctl:ReminderCard DataContext="{Binding Card}" IsHitTestVisible="False" />
            </Button>
        </DataTemplate>

        <!-- One segment of the Work / Chat switch (same look as the calendar's Month / Week / Agenda; the pill behind it slides). -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="9" Padding="14,4" MinHeight="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:UserBubble}">
            <Border Style="{StaticResource GlassChip}" HorizontalAlignment="Right" MaxWidth="520" Padding="14,8" Margin="0,0,0,10"
                    ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="8">
                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReplyBubble}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" HorizontalAlignment="Left" MaxWidth="560" Margin="2,0,0,10"
                       ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="8" />
        </DataTemplate>

        <!-- A Chat reply, growing as the model writes it. -->
        <DataTemplate DataType="{x:Type vm:StreamBubble}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" HorizontalAlignment="Left" MaxWidth="560" TextWrapping="Wrap" Margin="2,0,0,10" />
        </DataTemplate>

        <!-- Chat found a request: one tap switches to Work and shows the confirm card. -->
        <DataTemplate DataType="{x:Type vm:WorkChip}">
            <Button x:Name="Chip" Content="{Binding Label}" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Margin="2,0,0,10"
                    Command="{Binding RunCommand}" AutomationProperties.AutomationId="AssistantDoInWork" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPending}" Value="False">
                    <Setter TargetName="Chip" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FoundBubble}">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,10">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" ctl:Anim.FadeInOnLoad="True" />
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource FoundCard}" Focusable="False" IsTabStop="False" />
            </StackPanel>
        </DataTemplate>

        <!-- The confirm card: every change listed; collapses once answered. -->
        <DataTemplate DataType="{x:Type vm:ConfirmBubble}">
            <Grid x:Name="Root" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12" ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="8">
                <Border Style="{StaticResource GlassShadow}" />
                <Border Style="{StaticResource GlassCard}" Padding="16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfirmRow}">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                        <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="Flag" Text="{l:Loc Common_Important}" Style="{StaticResource Caption}" Visibility="Collapsed"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Important}" Value="True">
                                            <Setter TargetName="Flag" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <ui:Button x:Name="ConfirmButton" Appearance="Primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                                       AutomationProperties.AutomationId="AssistantConfirm" />
                            <Button Content="{l:Loc Common_Cancel}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                    AutomationProperties.AutomationId="AssistantCancel" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDelete}" Value="True">
                    <Setter TargetName="ConfirmButton" Property="Appearance" Value="Danger" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="False">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- "Which one?": up to four compact cards plus Cancel. -->
        <DataTemplate DataType="{x:Type vm:ChoiceBubble}">
            <StackPanel x:Name="Root" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12" ctl:Anim.FadeInOnLoad="True" ctl:Anim.Slide="8">
                <TextBlock Text="{Binding Prompt}" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding Choices}" Focusable="False" IsTabStop="False" />
                <Button Content="{l:Loc Common_Cancel}" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Command="{Binding CancelCommand}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPending}" Value="False">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{DynamicResource PagePadding}" MaxWidth="900" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Assistant_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Assistant_Caption_English}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                <TextBlock ctl:Anim.FadeInOnLoad="True" Text="{l:Loc Assistant_Caption_Mistakes}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding RunningOn}" Style="{StaticResource Caption}" Margin="0,2,0,0" AutomationProperties.AutomationId="AssistantRunningOn" />
                <TextBlock Text="{Binding GpuNote}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <!-- Work / Chat: one selection pill slides between two equal segments. -->
            <Border Grid.Column="1" Style="{StaticResource GlassChip}" Padding="3" CornerRadius="12" VerticalAlignment="Top" Margin="16,4,0,0"
                    ctl:Anim.FadeInOnLoad="True">
                <Grid>
                    <Border x:Name="ModePill" HorizontalAlignment="Left" Width="0" CornerRadius="9"
                            Background="{DynamicResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" />
                    <UniformGrid x:Name="ModeGrid" Rows="1" Columns="2">
                        <RadioButton GroupName="AssistantMode" Content="{l:Loc Assistant_Mode_Work}" Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsWork, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Assistant_Mode_WorkName}"
                                     AutomationProperties.AutomationId="AssistantModeWork" />
                        <RadioButton GroupName="AssistantMode" Content="{l:Loc Assistant_Mode_Chat}" Style="{StaticResource SegmentButton}"
                                     IsChecked="{Binding IsChat, Mode=TwoWay}" AutomationProperties.Name="{l:Loc Assistant_Mode_ChatName}"
                                     AutomationProperties.AutomationId="AssistantModeChat" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
            <StackPanel>
                <!-- Model not found / warming up / could not load. -->
                <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassCard}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding StateTitle}" Style="{StaticResource BodyStrong}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- No model yet (or one downloading): the size picker. -->
                <Grid MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassCard}" Padding="16">
                        <ctl:ModelPicker DataContext="{Binding Models}" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Messages}" Focusable="False" IsTabStop="False" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <!-- Live voice line: Listening..., the transcript, or a microphone problem. -->
            <StackPanel Orientation="Horizontal" Margin="2,0,0,8" Visibility="{Binding HasVoiceStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding VoiceStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="VoiceStatus" />
                <Button Content="{l:Loc Voice_OpenMicSettings}" Style="{StaticResource GlassPill}" Margin="12,0,0,0" Command="{Binding OpenMicSettingsCommand}"
                        Visibility="{Binding ShowMicLink, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="VoiceOpenMicSettings" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctl:VoiceOrb Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" State="{Binding Orb}" Level="{Binding OrbLevel}" Command="{Binding ToggleMicCommand}" />
                <ui:TextBox x:Name="InputBox" Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanType}"
                            PlaceholderText="{l:Loc Assistant_Placeholder}" AutomationProperties.Name="{l:Loc Assistant_Placeholder}"
                            AutomationProperties.AutomationId="AssistantInput">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Primary" Content="{l:Loc Assistant_Send}" Command="{Binding SendCommand}"
                           AutomationProperties.AutomationId="AssistantSend" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
