<UserControl x:Class="Remindr.Views.Controls.ReminderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             xmlns:conv="clr-namespace:Remindr.Converters"
             xmlns:vm="clr-namespace:Remindr.ViewModels"
             xmlns:l="clr-namespace:Remindr.Views">
    <!-- One reminder card. DataContext = ReminderItemViewModel. Shared by All Reminders and the Calendar views. -->
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:PictureConverter x:Key="PictureConv" />

        <!-- Borderless icon toggle (the quick Important flag). -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSmall}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Square-ish glass icon button for edit / delete. -->
        <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource GlassPill}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Shadow is a sibling (no Effect on the text-bearing card). -->
        <DataTemplate x:Key="ReminderCardTemplate" DataType="{x:Type vm:ReminderItemViewModel}">
            <Grid x:Name="CardRoot" Margin="0,0,0,10" ctl:Anim.FadeInOnLoad="{Binding Animate}" ctl:Anim.Slide="8">
                <Border Style="{StaticResource GlassShadow}" />
                <Border x:Name="Card" Style="{StaticResource GlassCard}" Padding="14,12">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:Loc Common_Edit}" Command="{Binding EditCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{l:Loc Common_Delete}" Command="{Binding DeleteCommand}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Name="DoneCheck" Grid.Column="0" MinWidth="0" Padding="0" Margin="0,0,12,0" VerticalAlignment="Top"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding CompleteAutomationName}" />

                        <StackPanel x:Name="Body" Grid.Column="1" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Optional reminder picture; missing/unknown keys collapse (no gap). Decoded at 64px, cached. -->
                                <Image x:Name="IconImage" FlowDirection="LeftToRight" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                       Source="{Binding Reminder.Icon, Converter={StaticResource PictureConv}, ConverterParameter=64}"
                                       AutomationProperties.Name="{Binding IconLabel}" />
                                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                    <ui:SymbolIcon x:Name="ClockIcon" Symbol="Clock24" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Style="{StaticResource GlassChip}" Margin="0,0,10,0"
                                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding CategoryColor, Converter={StaticResource HexToBrush}}" />
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <!-- Important badge: red "!" pill. -->
                                <!-- Fixed red (not the theme critical brush, which is pale in Dark) so the white "!" text always reads. -->
                                <Border x:Name="ImportantBadge" Background="#D13438"
                                        CornerRadius="10" Padding="7,1" Visibility="Collapsed"
                                        AutomationProperties.Name="{l:Loc Common_Important}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,4,0" />
                                        <TextBlock x:Name="ImportantText" Text="{l:Loc Common_Important}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="NotesText" Text="{Binding Notes}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="18"
                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                            <!-- Edit / delete show on hover or keyboard focus. They come first so the Important flag, which is always
                                 visible, sits at the card's trailing edge (it mirrors under right-to-left) instead of floating mid-card. -->
                            <StackPanel x:Name="HoverActions" Orientation="Horizontal" Opacity="0">
                                <Button Style="{StaticResource IconAction}" Command="{Binding EditCommand}" Margin="0,0,4,0"
                                        ToolTip="{l:Loc Common_Edit}" AutomationProperties.Name="{l:Loc Card_EditName}">
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource IconAction}" Command="{Binding DeleteCommand}" Margin="0,0,4,0"
                                        ToolTip="{l:Loc Common_Delete}" AutomationProperties.Name="{l:Loc Card_DeleteName}">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <ToggleButton x:Name="ImportantFlag" Style="{StaticResource IconToggle}" IsChecked="{Binding IsImportant, Mode=TwoWay}"
                                          ToolTip="{l:Loc Card_ImportantTooltip}" AutomationProperties.Name="{l:Loc Common_Important}">
                                <ui:SymbolIcon Symbol="Flag24" FontSize="16" Filled="{Binding IsImportant}" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsImportant}" Value="True">
                    <Setter TargetName="ImportantBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Compact (week column): no flag/hover buttons, notes or badge text; edit and delete are in the right-click menu. -->
                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                    <Setter TargetName="Card" Property="Padding" Value="4,6" />
                    <Setter TargetName="DoneCheck" Property="Margin" Value="0,0,4,0" />
                    <Setter TargetName="TitleText" Property="FontSize" Value="13" />
                    <Setter TargetName="IconImage" Property="Width" Value="20" />
                    <Setter TargetName="IconImage" Property="Height" Value="20" />
                    <Setter TargetName="IconImage" Property="Margin" Value="0,0,6,0" />
                    <Setter TargetName="TitleText" Property="TextWrapping" Value="NoWrap" />
                    <Setter TargetName="TitleText" Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NotesText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ImportantText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ClockIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CardRoot" Property="Margin" Value="0,0,0,8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompact}" Value="False">
                    <Setter TargetName="Card" Property="ContextMenuService.IsEnabled" Value="False" />
                </DataTrigger>
                <!-- Done: strike-through and fade. -->
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity"
                                                 To="0.5" Duration="{StaticResource DurNormal}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource DurNormal}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverActions" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource DurFast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverActions" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="{StaticResource DurFast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
                <!-- Neither hovered nor focused: fade the actions back out (a held animation would otherwise keep them at 1). -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition SourceName="Card" Property="IsMouseOver" Value="False" />
                        <Condition SourceName="Card" Property="IsKeyboardFocusWithin" Value="False" />
                    </MultiTrigger.Conditions>
                    <MultiTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverActions" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="{StaticResource DurFast}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiTrigger.EnterActions>
                </MultiTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ReminderCardTemplate}" Focusable="False" />
</UserControl>

