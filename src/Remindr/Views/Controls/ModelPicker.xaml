<UserControl x:Class="Remindr.Views.Controls.ModelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Remindr.ViewModels"
             xmlns:l="clr-namespace:Remindr.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A model size card: one radio button, so arrow keys move between the cards and Narrator reads the whole card. -->
        <Style x:Key="TierRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Style="{StaticResource GlassChip}" Padding="14,10" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TierCard}">
                    <RadioButton GroupName="ModelTier" Style="{StaticResource TierRadio}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding CanRun}" AutomationProperties.Name="{Binding AutomationName}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRun}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding InstalledText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Download / Switch -->
        <ui:Button Appearance="Primary" HorizontalAlignment="Left" Content="{Binding StartLabel}" Command="{Binding DownloadCommand}"
                   Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ModelDownload" />

        <!-- Progress with Pause / Resume / Cancel, then "Verifying..." -->
        <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,6,0,8"
                         AutomationProperties.Name="{Binding ProgressText}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{l:Loc Assistant_Dl_Pause}" Style="{StaticResource GlassPill}" Command="{Binding PauseCommand}"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ModelPause" />
                <Button Content="{l:Loc Assistant_Dl_Resume}" Style="{StaticResource GlassPill}" Command="{Binding ResumeCommand}"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="ModelResume" />
                <Button Content="{l:Loc Common_Cancel}" Style="{StaticResource GlassPill}" Margin="8,0,0,0" Command="{Binding CancelDownloadCommand}"
                        AutomationProperties.AutomationId="ModelCancel" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                   AutomationProperties.LiveSetting="Assertive" />

        <Button Content="{l:Loc Assistant_Dl_Remove}" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Margin="0,8,0,0"
                Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                AutomationProperties.AutomationId="ModelRemove" />

        <!-- Credit and licence link. -->
        <Button Style="{StaticResource GlassPill}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenLicenseCommand}"
                Content="{l:Loc Assistant_Model_Credit}" AutomationProperties.AutomationId="ModelLicense" />
    </StackPanel>
</UserControl>
