<UserControl x:Class="Remindr.Views.Controls.LanguageList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Remindr.Views"
             Focusable="False">
    <UserControl.Resources>
        <!-- One language: native name (shaped, directed and fonted by its own language), the English name and the Machine-translated tag below it. -->
        <Style x:Key="LanguageRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Frame" Background="Transparent" CornerRadius="10" Padding="14,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NativeName}" FontSize="15" Language="{Binding Xml}" FontFamily="{Binding Font}"
                                               FlowDirection="{Binding Flow}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="{Binding EnglishName}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                        <Border x:Name="Tag" Margin="8,0,0,0" Padding="6,1" CornerRadius="6" VerticalAlignment="Center"
                                                Background="{DynamicResource GlassChipBrush}" BorderBrush="{DynamicResource GlassStrokeBrush}" BorderThickness="1"
                                                Visibility="{Binding TagVisibility}">
                                            <TextBlock Text="{l:Loc Language_MachineTranslated}" FontSize="11" Opacity="0.85" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <ui:SymbolIcon x:Name="Check" Grid.Column="1" Symbol="Checkmark24" FontSize="16" Visibility="Collapsed" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource GlassPillHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox" Margin="0,0,0,8" PlaceholderText="{l:Loc Setup_Language_Search}"
                    AutomationProperties.Name="{l:Loc Setup_Language_Search}"
                    TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />

        <Grid Grid.Row="1">
            <!-- ListBox virtualises (VirtualizingStackPanel, recycling), so only the visible rows exist. -->
            <ListBox x:Name="Box" ItemContainerStyle="{StaticResource LanguageRow}" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" PreviewKeyDown="List_PreviewKeyDown" PreviewMouseLeftButtonUp="List_MouseUp"
                     AutomationProperties.Name="{l:Loc Settings_Language_Name}" />
            <TextBlock x:Name="NoMatch" Text="{l:Loc Setup_Language_NoMatch}" Opacity="0.7" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        </Grid>

        <Button x:Name="HelpButton" Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Help_Click"
                Style="{StaticResource GlassPill}" Content="{l:Loc Language_HelpTranslate}" AutomationProperties.Name="{l:Loc Language_HelpTranslate}" />
    </Grid>
</UserControl>
