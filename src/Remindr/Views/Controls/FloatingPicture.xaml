<UserControl x:Class="Remindr.Views.Controls.FloatingPicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Remindr.Views.Controls"
             Focusable="False" IsTabStop="False" HorizontalAlignment="Left">
    <!-- Remind UI 0.4 empty-state picture: a built-in picture at a fixed size that floats slowly (Anim.Float, TranslateY +-4 over DurFloat).
         Decorative: not hit-testable. Never mirrored under right-to-left. -->
    <Image x:Name="Pic" FlowDirection="LeftToRight" Stretch="Uniform" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality" ctl:Anim.Float="True" />
</UserControl>
