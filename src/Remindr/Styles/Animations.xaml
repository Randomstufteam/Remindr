<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Motion tokens. Reference these with StaticResource; no inline durations anywhere else.
         With reduced motion (SystemParameters.ClientAreaAnimation off) App.OnStartup replaces them with 0 before any view loads. -->
    <Duration x:Key="DurFast">0:0:0.15</Duration>
    <Duration x:Key="DurNormal">0:0:0.2</Duration>
    <Duration x:Key="DurSlow">0:0:0.25</Duration>
    <Duration x:Key="DurShake">0:0:0.3</Duration>
    <!-- Welcome / setup "hero" motion: a greeting word settling in, leaving, the blob hue shift, and a step's slide. -->
    <Duration x:Key="DurHero">0:0:0.65</Duration>
    <Duration x:Key="DurHeroOut">0:0:0.4</Duration>
    <Duration x:Key="DurHue">0:0:1</Duration>

    <!-- Remind UI 0.4: an element or view entering, and one leaving. -->
    <Duration x:Key="DurEnter">0:0:0.32</Duration>
    <Duration x:Key="DurExit">0:0:0.18</Duration>
    <!-- One full cycle of the empty-state picture float (TranslateY +-4). Zero under reduced motion, so the float never starts. -->
    <Duration x:Key="DurFloat">0:0:6</Duration>

    <!-- Delay between staggered items, in milliseconds. Every Dur* and Stagger* key is zeroed under reduced motion (MotionPolicy). -->
    <sys:Double x:Key="StaggerMs">40</sys:Double>
    <sys:Double x:Key="StaggerRevealMs">90</sys:Double>

    <!-- False under reduced motion: decorative loops (blob drift) should not start. -->
    <sys:Boolean x:Key="MotionEnabled">True</sys:Boolean>

    <!-- Second half of the single effects gate: Anim.EffectsEnabled = MotionEnabled AND VisualEffectsEnabled.
         False with the Debug-only no-effects launch argument; Phase 6.9 "Reduce visual effects" flips it at runtime. Never cached. -->
    <sys:Boolean x:Key="VisualEffectsEnabled">True</sys:Boolean>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
    <!-- Remind UI 0.4 "pop": a small overshoot. -->
    <BackEase x:Key="EasePop" EasingMode="EaseOut" Amplitude="0.3" />
</ResourceDictionary>
