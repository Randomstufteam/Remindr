<UserControl x:Class="Remindr.Setup.ErrorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="48,28">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource SetupWarnBrush}" Opacity="0.16" />
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SetupWarnBrush}" />
            </Grid>
            <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0" />
            <TextBlock x:Name="Message" Style="{StaticResource Body}" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="500" />
            <TextBlock x:Name="LogNote" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" MaxWidth="500" />
        </StackPanel>
    </Grid>
</UserControl>
