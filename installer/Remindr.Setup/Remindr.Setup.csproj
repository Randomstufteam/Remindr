<Project Sdk="Microsoft.NET.Sdk">

  <!-- Setup stub: WPF on .NET Framework 4.8 (ships with Windows 10 1903+ / 11), so it is ~1 MB instead of carrying a second runtime.
       Deliberately does NOT use WPF-UI; its styles are copied into Styles\ . -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Remindr.Setup</RootNamespace>
    <AssemblyName>Remindr.Setup</AssemblyName>
    <ApplicationIcon>Assets\remindr.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Remindr Setup</Product>
    <Description>Remindr Setup</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core is compiled INTO the stub (source link, not a ProjectReference) so the installer stays a single exe with no side dll.
         The net8 tests reference the Core project, which compiles the same files. -->
    <Compile Include="..\Remindr.Setup.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- Repo identity (URL, publisher, AUMID) comes from the app's single source of truth. -->
    <Compile Include="..\..\src\Remindr\RepoInfo.cs" Link="RepoInfo.cs" />
    <Resource Include="Assets\remindr.ico" />
  </ItemGroup>

</Project>
