<Window x:Class="Remindr.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remindr.Setup"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Remindr Setup" Icon="Assets/remindr.ico"
        Width="776" Height="516" ResizeMode="CanMinimize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="28">
        <!-- Drop shadow comes from a separate shape behind the frame so the text and images inside are never rasterised by an Effect. -->
        <Border CornerRadius="22" Background="{DynamicResource SetupBaseBrush}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.38" Color="Black" /></Border.Effect>
        </Border>

        <Grid x:Name="Frame" Width="720" Height="460" Background="{DynamicResource SetupBaseBrush}">
            <Grid.Clip><RectangleGeometry Rect="0,0,720,460" RadiusX="22" RadiusY="22" /></Grid.Clip>

            <!-- Drifting colour blobs (blurred once into a BitmapCache; the drift only moves the cached bitmap). -->
            <Grid x:Name="Blobs" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="Blob0" Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-90,-110,0,0"
                         Opacity="{DynamicResource SetupBlobOpacity}" Fill="#3B82F6">
                    <Ellipse.Effect><BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" /></Ellipse.Effect>
                    <Ellipse.CacheMode><BitmapCache /></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob1" Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-80,0"
                         Opacity="{DynamicResource SetupBlobOpacity}" Fill="#8B5CF6">
                    <Ellipse.Effect><BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" /></Ellipse.Effect>
                    <Ellipse.CacheMode><BitmapCache /></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob2" Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-110,0,0,-170"
                         Opacity="{DynamicResource SetupBlobOpacity}" Fill="#EC4899">
                    <Ellipse.Effect><BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" /></Ellipse.Effect>
                    <Ellipse.CacheMode><BitmapCache /></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Blob3" Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-70,-130"
                         Opacity="{DynamicResource SetupBlobOpacity}" Fill="#10B981">
                    <Ellipse.Effect><BlurEffect Radius="70" KernelType="Gaussian" RenderingBias="Performance" /></Ellipse.Effect>
                    <Ellipse.CacheMode><BitmapCache /></Ellipse.CacheMode>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <!-- Specular edge around the whole window. -->
            <Border CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource GlassStrokeBrush}" IsHitTestVisible="False" />

            <Grid x:Name="MainContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="72" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                        <local:LogoMark Width="20" Height="20" />
                        <TextBlock x:Name="TitleText" Text="Remindr Setup" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,12,0" VerticalAlignment="Top">
                        <Button x:Name="MinButton" Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Min_Click"
                                automation:AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="&#xE8BB;" Click="Close_Click"
                                automation:AutomationProperties.Name="Close" ToolTip="Close" />
                    </StackPanel>
                </Grid>

                <!-- Page panel -->
                <Grid Grid.Row="1" Margin="28,0,28,0">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassPanel}" ClipToBounds="True">
                        <Grid x:Name="PageHost" ClipToBounds="True" />
                    </Border>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="28,0,28,0">
                    <Button x:Name="CancelButton" Style="{StaticResource GlassPill}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Content="Cancel" Click="Cancel_Click" automation:AutomationProperties.Name="Cancel" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackButton" Style="{StaticResource GlassPill}" Margin="0,0,10,0" Content="Back" Click="Back_Click"
                                automation:AutomationProperties.Name="Back" />
                        <Button x:Name="PrimaryButton" Style="{StaticResource AccentPill}" Content="Next" Click="Primary_Click"
                                automation:AutomationProperties.Name="Next" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Question overlay (cancel setup? close Remindr?). -->
            <Grid x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource SetupOverlayBrush}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
                    <Border Style="{StaticResource GlassShadow}" />
                    <Border Style="{StaticResource GlassPanel}" Background="{DynamicResource SetupBaseBrush}" Padding="28,24,28,22">
                        <StackPanel>
                            <TextBlock x:Name="OverlayTitle" Style="{StaticResource SectionHeader}" FontSize="20" />
                            <TextBlock x:Name="OverlayBody" Style="{StaticResource Body}" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                <Button x:Name="OverlayLeft" Style="{StaticResource GlassPill}" Margin="0,0,10,0" Click="OverlayLeft_Click" />
                                <Button x:Name="OverlayRight" Style="{StaticResource AccentPill}" Click="OverlayRight_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>


