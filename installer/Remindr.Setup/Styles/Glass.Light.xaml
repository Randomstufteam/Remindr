<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Glass brushes copied from src\Remindr\Styles\Glass.Light.xaml (keep identical), plus the WPF-UI brushes the shared styles reference. -->

    <!-- Card/panel surface: base fill plus an inner highlight over the top third. Border clips it to the corner radius. -->
    <DrawingBrush x:Key="GlassSurfaceBrush" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,1,1">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#B8FFFFFF">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2EFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,0.33" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 1px specular edge: bright at the top-left, fading to the bottom-right. -->
    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3FFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassNavSurfaceBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="GlassPillBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="GlassPillHoverBrush" Color="#CCFFFFFF" />
    <SolidColorBrush x:Key="GlassPillPressedBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassChipBrush" Color="#8CFFFFFF" />
    <!-- Fill +25% opacity: put behind body text that sits on a busy backdrop. -->
    <SolidColorBrush x:Key="GlassTextBackingBrush" Color="#CCFFFFFF" />
    <!-- Disc behind avatar pictures (transparent PNGs). -->
    <SolidColorBrush x:Key="GlassDiscBrush" Color="#66FFFFFF" />

    <!-- WPF-UI Light values (TextFillColor*, FocusStrokeColorOuter) used by Tokens.xaml/Glass.xaml. Accent is set from Windows at startup. -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#E4000000" />
    <!-- Setup window only -->
    <LinearGradientBrush x:Key="SetupBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F6FB" Offset="0" />
        <GradientStop Color="#E6EAF4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SetupWarnBrush" Color="#B42318" />
    <SolidColorBrush x:Key="SetupOverlayBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="SetupTrackBrush" Color="#1F000000" />
    <sys:Double x:Key="SetupBlobOpacity">0.40</sys:Double>
</ResourceDictionary>

