<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Glass brushes copied from src\Remindr\Styles\Glass.Dark.xaml (keep identical), plus the WPF-UI brushes the shared styles reference. -->

    <!-- Card/panel surface: base fill plus an inner highlight over the top third. Border clips it to the corner radius. -->
    <DrawingBrush x:Key="GlassSurfaceBrush" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,1,1">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#A61C1C1E">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2EFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,0.33" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 1px specular edge: bright at the top-left, fading to the bottom-right. -->
    <LinearGradientBrush x:Key="GlassStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassNavSurfaceBrush" Color="#661C1C1E" />
    <SolidColorBrush x:Key="GlassPillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassPillHoverBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="GlassPillPressedBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassChipBrush" Color="#1FFFFFFF" />
    <!-- Fill +25% opacity: put behind body text that sits on a busy backdrop. -->
    <SolidColorBrush x:Key="GlassTextBackingBrush" Color="#B31C1C1E" />
    <!-- Disc behind avatar pictures (transparent PNGs). -->
    <SolidColorBrush x:Key="GlassDiscBrush" Color="#33FFFFFF" />

    <!-- WPF-UI Dark values (TextFillColor*, FocusStrokeColorOuter) used by Tokens.xaml/Glass.xaml. Accent is set from Windows at startup. -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFFFF" />
    <!-- Setup window only -->
    <LinearGradientBrush x:Key="SetupBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#232328" Offset="0" />
        <GradientStop Color="#141417" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SetupWarnBrush" Color="#FF9B8F" />
    <SolidColorBrush x:Key="SetupOverlayBrush" Color="#80000000" />
    <SolidColorBrush x:Key="SetupTrackBrush" Color="#33FFFFFF" />
    <sys:Double x:Key="SetupBlobOpacity">0.35</sys:Double>
</ResourceDictionary>

