<Application x:Class="Remindr.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Tokens.xaml" />
                <ResourceDictionary Source="Styles/Animations.xaml" />
                <ResourceDictionary Source="Styles/Glass.xaml" />
                <!-- Glass.Light / Glass.Dark (brushes) are merged by ThemeSetup according to the Windows app theme. -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
